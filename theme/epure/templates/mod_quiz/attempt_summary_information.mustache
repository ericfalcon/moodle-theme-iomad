{{!
    @template mod_quiz/attempt_summary_information

    Summary of a quiz attempt (status, dates, duration, marks...): Épure shows its items as tiles instead of a table.

    Example context (json):
    {
        "hasitems": true,
        "items": [
            {"title": "Status", "content": "Finished"},
            {"title": "Started", "content": "Thursday, 23 November 2023, 9:29 AM"},
            {"title": "Duration", "content": "3 minutes"},
            {"title": "Grade", "content": "Not yet graded"}
        ],
        "caption": "Summary of attempt"
    }
}}
{{#hasitems}}
<div class="epure-quiz-summary">
    {{#caption}}<h3 class="sr-only visually-hidden">{{caption}}</h3>{{/caption}}
    <dl class="epure-quiz-summary-items">
        {{#items}}
            <div class="epure-quiz-summary-item">
                <dt>{{{title}}}</dt>
                <dd>{{{content}}}</dd>
            </div>
        {{/items}}
    </dl>
</div>
{{/hasitems}}
