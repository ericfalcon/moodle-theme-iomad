{{!
    @template theme_epure/mobile_nav

    Navigation bar at the bottom of the screen on phones.

    Example context (json):
    {
        "items": [
            {"key": "home", "label": "Dashboard", "url": "#", "icon": "fa-gauge", "active": true, "hascount": false},
            {"key": "messages", "label": "Messages", "url": "#", "icon": "fa-comment", "active": false,
                "hascount": true, "count": 2, "countlabel": "2 unread"}
        ]
    }
}}
<nav class="epure-mobilenav" aria-label="{{#str}}mobilenav, theme_epure{{/str}}">
    <ul>
        {{#items}}
            <li>
                <a href="{{url}}" class="epure-mobilenav-{{key}}{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                    <span class="epure-mobilenav-icon">
                        <i class="fa {{icon}}" aria-hidden="true"></i>
                        {{#hascount}}<span class="epure-mobilenav-count" aria-hidden="true">{{count}}</span>{{/hascount}}
                    </span>
                    <span class="epure-mobilenav-label">{{label}}</span>
                    {{#hascount}}<span class="sr-only visually-hidden">({{countlabel}})</span>{{/hascount}}
                </a>
            </li>
        {{/items}}
    </ul>
</nav>
