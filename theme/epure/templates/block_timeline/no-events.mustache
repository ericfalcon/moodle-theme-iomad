{{!
    @template block_timeline/no-events

    Override of Épure: nothing to do, in a clear sentence, with the calendar as the next step.

    Example context (json):
    {
        "urls": {
            "noevents": "#"
        }
    }
}}
<div class="hidden" data-region="no-events-empty-message">
    {{< theme_epure/empty_state }}
        {{$icon}}fa-regular fa-calendar-check{{/icon}}
        {{$title}}{{#str}} noevents, block_timeline {{/str}}{{/title}}
        {{$text}}{{#str}} empty_timeline, theme_epure {{/str}}{{/text}}
        {{$actions}}<a class="btn btn-outline-secondary btn-sm" href="{{config.wwwroot}}/calendar/view.php?view=upcoming">{{#str}} empty_calendar, theme_epure {{/str}}</a>{{/actions}}
    {{/ theme_epure/empty_state }}
</div>
