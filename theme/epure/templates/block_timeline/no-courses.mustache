{{!
    @template block_timeline/no-courses

    Override of Épure: no course in progress, in a clear sentence, with the courses of the user as the next step.

    Example context (json):
    {
        "hascourses": false,
        "urls": {
            "noevents": "#"
        }
    }
}}
{{^hascourses}}
    <div data-region="no-courses-empty-message">
        {{< theme_epure/empty_state }}
            {{$icon}}fa-solid fa-graduation-cap{{/icon}}
            {{$title}}{{#str}} nocoursesinprogress, block_timeline {{/str}}{{/title}}
            {{$text}}{{#str}} empty_timelinecourses, theme_epure {{/str}}{{/text}}
            {{$actions}}<a class="btn btn-outline-secondary btn-sm" href="{{config.wwwroot}}/my/courses.php">{{#str}} mycourses {{/str}}</a>{{/actions}}
        {{/ theme_epure/empty_state }}
    </div>
{{/hascourses}}
