{{!
    @template theme_epure/quiz_legend

    Meaning of the marks of the panel of the questions during a quiz attempt.

    Example context (json):
    {
    }
}}
<ul class="epure-quiz-legend" aria-label="{{#str}}quizlegend, theme_epure{{/str}}">
    <li><span class="epure-quiz-legend-mark epure-quiz-legend-answered" aria-hidden="true"></span>{{#str}}quizlegend_answered, theme_epure{{/str}}</li>
    <li><span class="epure-quiz-legend-mark" aria-hidden="true"></span>{{#str}}quizlegend_unanswered, theme_epure{{/str}}</li>
    <li><span class="epure-quiz-legend-mark epure-quiz-legend-current" aria-hidden="true"></span>{{#str}}quizlegend_current, theme_epure{{/str}}</li>
    <li><i class="icon fa fa-flag fa-fw epure-quiz-legend-flag" aria-hidden="true"></i>{{#str}}quizlegend_flagged, theme_epure{{/str}}</li>
</ul>
