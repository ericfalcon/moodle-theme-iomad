{{!
    @template core_course/no-courses

    Override of Épure: no courses, in a clear sentence (the block nocoursestring, as in Moodle), with the
    next step: creating a course when the user can, else the catalogue.

    Example context (json):
    {
        "nocoursesimgurl": "https://moodlesite/theme/image.php/boost/block_recentlyaccessedcourses/1535727318/courses",
        "newcourseurl": "https://moodlesite/course/edit.php"
    }
}}
<div data-region="empty-message">
    {{< theme_epure/empty_state }}
        {{$icon}}fa-solid fa-graduation-cap{{/icon}}
        {{$title}}{{$nocoursestring}}{{#str}} nocourses, core {{/str}}{{/nocoursestring}}{{/title}}
        {{$text}}{{#str}} empty_courses, theme_epure {{/str}}{{/text}}
        {{$actions}}
            {{#newcourseurl}}
                <a href="{{{newcourseurl}}}" class="btn btn-outline-secondary btn-sm nocourseslink">{{#str}} createnewcourse, core {{/str}}</a>
            {{/newcourseurl}}
            {{^newcourseurl}}
                <a href="{{config.wwwroot}}/course/index.php" class="btn btn-outline-secondary btn-sm">{{#str}} empty_catalogue, theme_epure {{/str}}</a>
            {{/newcourseurl}}
        {{/actions}}
    {{/ theme_epure/empty_state }}
</div>
