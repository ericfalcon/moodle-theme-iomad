{{!
    @template core/add_block_button

    The place to add a block, in edit mode: a dashed card with « Add a block » (the link that opens the window, the
    same as Moodle's) and a sentence of what can be added. The whole card can be clicked.

    Example context (json):
    {
        "link" : "/my/index.php?bui_addblock&bui_blockregion=content&sesskey=M3mes",
        "escapedlink" : "?bui_addblock&bui_blockregion=content&sesskey=M3mes",
        "pagehash": "abcdefgh",
        "blockregion": "side-pre"
    }
}}
<div class="add_block_button epure-addblock-button" data-region="add-block-button">
    <span class="epure-addblock-plus" aria-hidden="true"><i class="fa fa-plus"></i></span>
    <a href="{{link}}" id="addblock-{{uniqid}}" class="block-add epure-addblock-open" data-key="addblock"
            data-url="{{escapedlink}}" data-blockregion="{{blockregion}}">{{#str}}addblock{{/str}}</a>
    <span class="epure-addblock-hint">{{#str}}addblock_hint, theme_epure{{/str}}</span>
</div>

{{#js}}
    // Initialise the JS for the modal window which displays the blocks available to add.
    require(['core_block/add_modal', 'theme_epure/add_block'], function(addBlockModal, addBlock) {
        addBlockModal.init(null, '{{pagehash}}');
        addBlock.init();
    });
{{/js}}
