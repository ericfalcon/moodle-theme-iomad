{{!
    @template core/add_block_body

    The blocks that can be added to a page, in the window « Add a block » (and on its page without JavaScript):
    a search, then one row per block with its icon, its name (the link that adds it, the same as Moodle's) and
    « Add ». The script theme_epure/add_block gives each block its icon and filters the rows as the user types.

    Example context (json):
    {
        "blocks" : [
            { "name": "calendar_month", "title": "Calendar" },
            { "name": "html", "title": "Text", "blockform": "block_edit_form" }
        ],
        "url" : "?a=b",
        "blockregion": "side-pre"
    }
}}
<div class="epure-addblock">
    {{#blocks.0}}
        <div class="epure-addblock-search">
            <label class="sr-only visually-hidden" for="epure-addblock-search-{{uniqid}}">{{#str}}addblock_search, theme_epure{{/str}}</label>
            <i class="fa fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="epure-addblock-search-{{uniqid}}" class="form-control" autocomplete="off"
                placeholder="{{#str}}addblock_search, theme_epure{{/str}}" data-region="epure-addblock-search">
        </div>
    {{/blocks.0}}
    <ul class="epure-addblock-list">
        {{#blocks}}
            <li class="epure-addblock-item" data-blockname="{{name}}">
                <span class="epure-addblock-icon" aria-hidden="true"><i class="fa fa-puzzle-piece"></i></span>
                <a href="{{url}}&amp;bui_addblock={{name}}" class="epure-addblock-link"
                    data-blockname="{{name}}" data-blocktitle="{{title}}" data-blockregion="{{blockregion}}"
                    {{#blockform}}data-action="showaddblockform" data-blockform="{{blockform}}"{{/blockform}}
                >{{#blockform}}{{#str}}textellipsis, moodle, {{title}}{{/str}}{{/blockform}}{{^blockform}}{{title}}{{/blockform}}</a>
                <span class="epure-addblock-action" aria-hidden="true">{{#str}}add{{/str}}</span>
            </li>
        {{/blocks}}
    </ul>
    <p class="epure-addblock-none" data-region="epure-addblock-none" role="status" hidden>{{#str}}addblock_none, theme_epure{{/str}}</p>
    {{^blocks}}
        <div class="alert alert-primary" role="alert">
            {{#str}} noblockstoaddhere {{/str}}
        </div>
    {{/blocks}}
</div>
{{#js}}
    require(['theme_epure/add_block'], function(addBlock) {
        addBlock.init();
    });
{{/js}}
