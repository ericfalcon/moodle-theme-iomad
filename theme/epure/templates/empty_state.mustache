{{!
    @template theme_epure/empty_state

    An empty state: an icon, what is empty in a clear sentence, what it will hold, and the next step. Its
    parts are blocks, so that the strings can be given by the templates that use it, also in JavaScript:
    icon (Font Awesome classes), title, text and actions (links with the classes btn).

    Example context (json):
    {}
}}
<div class="epure-empty">
    <span class="epure-empty-icon" aria-hidden="true"><i class="{{$icon}}fa-regular fa-folder-open{{/icon}}"></i></span>
    <p class="epure-empty-title">{{$title}}{{/title}}</p>
    <p class="epure-empty-text">{{$text}}{{/text}}</p>
    <div class="epure-empty-actions">{{$actions}}{{/actions}}</div>
</div>
