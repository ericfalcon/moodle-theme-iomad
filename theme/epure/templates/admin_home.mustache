{{!
    @template theme_epure/admin_home

    Home of the site administration: a card for each part (Users, Courses, Appearance…) with its common tasks.
    The title of a card leads to the whole part.

    Example context (json):
    {
        "cards": [
            {"name": "Users", "url": "#", "icon": "fa-users", "tasks": [{"name": "Browse list of users", "url": "#"}]}
        ]
    }
}}
<section class="epure-admin-home" aria-labelledby="epure-admin-home-title">
    <h2 class="epure-admin-home-title" id="epure-admin-home-title">{{#str}}adminhome, theme_epure{{/str}}</h2>
    <div class="epure-admin-home-cards">
        {{#cards}}
        <div class="epure-admin-card">
            <h3 class="epure-admin-card-title">
                <span class="epure-admin-card-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>
                <a href="{{url}}">{{name}}</a>
            </h3>
            <ul class="epure-admin-card-tasks">
                {{#tasks}}
                <li><a href="{{url}}">{{name}}</a></li>
                {{/tasks}}
            </ul>
        </div>
        {{/cards}}
    </div>
</section>
