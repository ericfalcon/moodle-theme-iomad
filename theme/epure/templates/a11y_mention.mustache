{{!
    @template theme_epure/a11y_mention

    Accessibility mention shown under the main region of every page, linking to the statement.

    Example context (json):
    {"status": "partially compliant", "url": "#"}
}}
<p class="epure-a11y-mention">
    <a href="{{url}}">{{#str}}a11ymention, theme_epure, {{status}}{{/str}}</a>
</p>
