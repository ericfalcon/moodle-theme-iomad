{{!
    @template theme_epure/busy

    Indicator shown while Moodle works on a step of an installation or an upgrade (see javascript/busy.js).
    The message is written into the live region when the indicator appears, so that screen readers announce it.

    Example context (json):
    {"message": "Moodle is working…", "detail": "This step can take a few minutes. Do not close this page."}
}}
<div class="epure-busy" id="epure-busy" data-message="{{message}} {{detail}}" hidden>
    <div class="epure-busy-box">
        <span class="epure-busy-spinner" aria-hidden="true"></span>
        <p class="epure-busy-title">{{message}}</p>
        <p class="epure-busy-detail">{{detail}}</p>
        <p class="sr-only visually-hidden" role="status" data-region="message"></p>
    </div>
</div>
