{{!
    @template theme_boost/login

    Login page of Épure: Boost's login layout, with an optional brand visual beside the form.
    The form itself stays Moodle's own (core/loginform), so it follows each Moodle version.

    Context variables required for this template:
    * sitename - Short name of the site (from the Boost layout).
    * output - The core renderer, which provides the epure_login_* methods.
    * bodyattributes - Attributes of the body element.

    Example context (json):
    {
        "sitename": "Campus",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Login page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headers keep HTML validators happy</h1>",
            "epure_login_split": true,
            "epure_login_sitename": "Campus Horizon",
            "epure_login_tagline": "Learn at your own pace.",
            "epure_login_text": "Your courses and certificates in one place.",
            "epure_login_image_url": "",
            "epure_login_logo_url": "",
            "epure_login_logo_backing": false
        }
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<div id="page-wrapper">

    {{{ output.standard_top_of_body_html }}}

    <div id="page" class="container-fluid {{#output.epure_login_split}}epure-login-split{{/output.epure_login_split}}{{^output.epure_login_split}}pt-5 mt-0{{/output.epure_login_split}}">
        {{#output.epure_login_split}}
        <div class="epure-login-visual{{#output.epure_login_image_url}} has-image{{/output.epure_login_image_url}}"
            {{#output.epure_login_image_url}}style="background-image: linear-gradient(var(--epure-login-overlay), var(--epure-login-overlay)), url('{{output.epure_login_image_url}}');"{{/output.epure_login_image_url}}>
            <div class="epure-login-brand">
                {{#output.epure_login_logo_url}}
                <img src="{{output.epure_login_logo_url}}" alt="{{output.epure_login_sitename}}" class="epure-login-logo{{#output.epure_login_logo_backing}} has-backing{{/output.epure_login_logo_backing}}">
                {{/output.epure_login_logo_url}}
                {{^output.epure_login_logo_url}}
                <span class="epure-login-sitename">{{output.epure_login_sitename}}</span>
                {{/output.epure_login_logo_url}}
            </div>
            <div class="epure-login-message">
                <p class="epure-login-tagline">{{output.epure_login_tagline}}</p>
                {{#output.epure_login_text}}
                <p class="epure-login-text">{{output.epure_login_text}}</p>
                {{/output.epure_login_text}}
            </div>
        </div>
        {{/output.epure_login_split}}
        <div id="page-content" class="row">
            <div id="region-main-box" class="col-12">
                <div id="region-main" class="col-12 h-100">
                <div class="login-wrapper">
                    <div class="login-container">
                    {{{ output.main_content }}}
                    </div>
                </div>
                </div>
            </div>
        </div>
    </div>
    {{{ output.epure_footer }}}
    {{> theme_boost/footer }}
</div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader'], function() {
  M.util.js_complete('theme_boost/loader');
});
{{/js}}
