{{!
    @template theme_boost/admin_setting_tabs

    Tabs of the settings of a theme, as in Boost, with a valid structure for assistive technologies:
    the items of the list are presentational, each tab controls its panel and labels it. The two
    attributes of the toggle serve Bootstrap 4 (Moodle 4.5) and Bootstrap 5 (Moodle 5).

    Example context (json):
    {
        "tabs": [
            {"name": "tab1", "active": 0, "displayname": "Inactive tab1", "html": "<p>Tab 1 content</p>"},
            {"name": "tab2", "active": 1, "displayname": "Active tab2", "html": "<p>Tab 2 content</p>"}
        ]
    }
}}
<ul class="nav nav-tabs" role="tablist">
    {{#tabs}}
        <li class="nav-item" role="presentation">
            <a href="#{{name}}" class="nav-link {{#active}}active{{/active}}" id="{{name}}-tab" data-toggle="tab" data-bs-toggle="tab"
                role="tab" aria-controls="{{name}}"
                {{#active}}aria-selected="true"{{/active}}
                {{^active}}aria-selected="false" tabindex="-1"{{/active}}>{{displayname}}</a>
        </li>
    {{/tabs}}
</ul>
<div class="tab-content mt-3">
    {{#tabs}}
        <div class="tab-pane {{#active}}active{{/active}}" id="{{name}}" role="tabpanel" aria-labelledby="{{name}}-tab">
            {{{html}}}
        </div>
    {{/tabs}}
</div>
