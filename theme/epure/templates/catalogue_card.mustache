{{!
    @template theme_epure/catalogue_card

    Card of a course in the catalogue: image, category, name, summary, teachers and how to enter it.

    Example context (json):
    {
        "id": 2, "name": "Safety at work", "url": "#", "image": "", "category": "Training",
        "summary": "The risks of the workplace and how to prevent them.", "contacts": "Tom Teacher",
        "hidden": false, "access": "Self enrolment", "accessclass": "self", "enrolled": false
    }
}}
<article class="epure-catalogue-card{{#hidden}} epure-catalogue-card-hidden{{/hidden}}" data-courseid="{{id}}">
    <div class="epure-catalogue-card-image" style="background-image: url('{{image}}');"></div>
    <div class="epure-catalogue-card-body">
        {{#category}}<p class="epure-catalogue-card-category">{{category}}</p>{{/category}}
        <h3 class="epure-catalogue-card-name"><a href="{{url}}">{{name}}</a></h3>
        {{#summary}}<p class="epure-catalogue-card-summary">{{summary}}</p>{{/summary}}
        <div class="epure-catalogue-card-footer">
            {{#contacts}}
                <span class="epure-catalogue-card-contacts"><i class="fa fa-user" aria-hidden="true"></i>{{contacts}}</span>
            {{/contacts}}
            {{#access}}
                <span class="badge epure-catalogue-access epure-catalogue-access-{{accessclass}}">
                    {{#enrolled}}<i class="fa fa-check" aria-hidden="true"></i>{{/enrolled}}{{access}}
                </span>
            {{/access}}
            {{#hidden}}<span class="badge epure-catalogue-access">{{#str}}hiddenfromstudents{{/str}}</span>{{/hidden}}
        </div>
    </div>
</article>
