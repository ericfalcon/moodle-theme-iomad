{{!
    @template theme_epure/company_select

    A setting of the site that an IOMAD company can set instead, in the Épure fields of its form: « As the site (…) »,
    then the choices of the site.

    Context variables required for this template:
    * name - name of the setting, posted as epure_<name>
    * label - label of the setting
    * options - value, label, selected
    * help - optional help under the list

    Example context (json):
    {
        "name": "quicksearch", "label": "Quick search", "help": "",
        "options": [{"value": "", "label": "As the site (On)", "selected": true},
            {"value": "show", "label": "On", "selected": false}, {"value": "hide", "label": "Off", "selected": false}]
    }
}}
<div class="form-group mb-3 row fitem">
    <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
        <label class="mb-0" for="id_epure_{{name}}">{{label}}</label>
    </div>
    <div class="col-md-9 d-flex flex-wrap align-items-start felement">
        <select class="custom-select form-select" id="id_epure_{{name}}" name="epure_{{name}}"
            {{#help}}aria-describedby="id_epure_{{name}}_help"{{/help}}>
            {{#options}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/options}}
        </select>
        {{#help}}<p class="small text-muted mt-1 mb-0 w-100" id="id_epure_{{name}}_help">{{help}}</p>{{/help}}
    </div>
</div>
