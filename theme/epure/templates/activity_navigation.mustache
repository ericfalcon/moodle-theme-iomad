{{!
    @template theme_epure/activity_navigation

    Previous and next activities of the course, as cards at the bottom of the page of an activity;
    after the last one, a card back to the course.

    Example context (json):
    {
        "previous": {"name": "Introduction", "url": "#", "icon": "", "section": "Week 1"},
        "next": {"name": "Quiz 1", "url": "#", "icon": "", "section": "Week 1"},
        "courseurl": "#"
    }
}}
<nav class="epure-activity-nav" aria-label="{{#str}}activitynavigation, theme_epure{{/str}}">
    {{#previous}}
        <a class="epure-activity-nav-card epure-activity-nav-previous" href="{{url}}">
            <i class="fa fa-chevron-left epure-activity-nav-arrow" aria-hidden="true"></i>
            <span class="epure-activity-nav-text">
                <span class="epure-activity-nav-label">{{#str}}activityprevious, theme_epure{{/str}}</span>
                <span class="epure-activity-nav-name">{{#icon}}<img src="{{icon}}" alt="" class="activityicon">{{/icon}}{{name}}</span>
                {{#section}}<span class="epure-activity-nav-section">{{section}}</span>{{/section}}
            </span>
        </a>
    {{/previous}}
    {{^previous}}<span class="epure-activity-nav-spacer"></span>{{/previous}}
    {{#next}}
        <a class="epure-activity-nav-card epure-activity-nav-next" href="{{url}}">
            <span class="epure-activity-nav-text">
                <span class="epure-activity-nav-label">{{#str}}activitynext, theme_epure{{/str}}</span>
                <span class="epure-activity-nav-name">{{#icon}}<img src="{{icon}}" alt="" class="activityicon">{{/icon}}{{name}}</span>
                {{#section}}<span class="epure-activity-nav-section">{{section}}</span>{{/section}}
            </span>
            <i class="fa fa-chevron-right epure-activity-nav-arrow" aria-hidden="true"></i>
        </a>
    {{/next}}
    {{^next}}
        <a class="epure-activity-nav-card epure-activity-nav-next epure-activity-nav-end" href="{{courseurl}}">
            <span class="epure-activity-nav-text">
                <span class="epure-activity-nav-label">{{#str}}activityend, theme_epure{{/str}}</span>
                <span class="epure-activity-nav-name">{{#str}}activityback, theme_epure{{/str}}</span>
            </span>
            <i class="fa fa-flag-checkered epure-activity-nav-arrow" aria-hidden="true"></i>
        </a>
    {{/next}}
</nav>
