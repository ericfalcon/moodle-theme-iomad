{{!
    @template block_recentlyaccesseditems/no-items

    Override of Épure: no item opened yet, in a clear sentence, with the courses of the user as the next step.

    Example context (json):
    {
        "noitemsimgurl": "https://moodlesite/theme/image.php/boost/block_recentlyaccesseditems/1535727318/items"
    }
}}
<div data-region="empty-message">
    {{< theme_epure/empty_state }}
        {{$icon}}fa-regular fa-clock{{/icon}}
        {{$title}}{{#str}} noitems, block_recentlyaccesseditems {{/str}}{{/title}}
        {{$text}}{{#str}} empty_recentitems, theme_epure {{/str}}{{/text}}
        {{$actions}}<a class="btn btn-outline-secondary btn-sm" href="{{config.wwwroot}}/my/courses.php">{{#str}} mycourses {{/str}}</a>{{/actions}}
    {{/ theme_epure/empty_state }}
</div>
