{{!
    @template theme_epure/logo_colours

    Colours of the logo, proposed under the brand colour setting.

    Context variables required for this template:
    * id - Identifier of the region.
    * inputid - Identifier of the colour input to fill.
    * logourl - URL of the logo, or null when there is no logo.

    Example context (json):
    {
        "id": "id_s_theme_epure_brandcolor_logocolours",
        "inputid": "id_s_theme_epure_brandcolor",
        "logourl": "https://example.com/pluginfile.php/1/theme_epure/logo/1/logo.png"
    }
}}
<div class="epure-logocolours" id="{{id}}" data-input="{{inputid}}">
    {{#logourl}}
        <p class="epure-logocolours-title">{{#str}}logocolours, theme_epure{{/str}}</p>
        <p class="small text-muted mb-2">{{#str}}logocolours_help, theme_epure{{/str}}</p>
        <img src="{{logourl}}" alt="" class="epure-logocolours-logo" data-region="logo">
        <div class="epure-logocolours-swatches" data-region="swatches" role="group"
            aria-label="{{#str}}logocolours, theme_epure{{/str}}"></div>
        <p class="small mb-0" data-region="status" aria-live="polite"></p>
    {{/logourl}}
    {{^logourl}}
        <p class="small text-muted mt-2 mb-0">{{#str}}logocolours_none, theme_epure{{/str}}</p>
    {{/logourl}}
</div>
