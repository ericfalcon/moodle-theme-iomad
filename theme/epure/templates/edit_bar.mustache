{{!
    @template theme_epure/edit_bar

    At the top of a course page in edit mode: that the edit mode is on, and a button to leave it, which does what
    the switch « Edit mode » of the header does.

    Example context (json):
    {
        "action": "https://example.com/editmode.php",
        "contextid": 2,
        "pageurl": "https://example.com/course/view.php?id=2",
        "sesskey": "abc"
    }
}}
<div class="epure-editbar">
    <p class="epure-editbar-text">
        <span class="epure-editbar-icon" aria-hidden="true"><i class="fa fa-pen"></i></span>
        <span><strong>{{#str}}editbar, theme_epure{{/str}}</strong> <span class="epure-editbar-hint">{{#str}}editbar_text, theme_epure{{/str}}</span></span>
    </p>
    <form method="post" action="{{action}}">
        <input type="hidden" name="setmode" value="0">
        <input type="hidden" name="context" value="{{contextid}}">
        <input type="hidden" name="pageurl" value="{{pageurl}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" class="btn btn-primary">{{#str}}editbar_done, theme_epure{{/str}}</button>
    </form>
</div>
