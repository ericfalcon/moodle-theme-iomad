{{!
    @template theme_epure/company_vocabulary_fields

    Épure fields of an IOMAD company, in numbered sections organised as the settings of the theme
    (theme, brand identity with the logos then the colours, typography and display, pages and
    navigation, footer, vocabulary, advanced), moved into the Appearance section of IOMAD's company form by the
    AMD module theme_epure/company_vocabulary, which also moves IOMAD's own appearance fields into
    these sections. Posted with that form.

    Context variables required for this template:
    * marker - name of the field telling that the vocabulary fields were posted
    * languages - lang, name, concepts (name, label, options, custom, singular, plural, hasgender, masculine, feminine)
    * brandcolor, sitebrandcolor, headerstyles, fonts, coursebanners, learnerdashboards, mobilenavs, darkmodes,
      activityicons - appearance of the company
    * accentcolor, siteaccentcolor - accent colour of the company and the one used while it has none
    * shapes, navigation, pages, emails, login - other settings of the site (see theme_epure/company_select)
    * logintexts - texts of the login page: name, label, value, multiline, placeholder (value of the site)
    * footer - footer fields of the company: name, label, value, multiline, placeholder (value of the site)
    * logocolours - context of theme_epure/logo_colours

    Example context (json):
    {
        "marker": "epure_vocab", "brandcolor": "", "sitebrandcolor": "#2559A8", "accentcolor": "", "siteaccentcolor": "#2559A8",
        "shapes": [], "navigation": [], "pages": [], "emails": [], "login": [], "logintexts": [],
        "headerstyles": [{"value": "", "label": "As the site (White)", "selected": true}],
        "fonts": [{"value": "", "label": "As the site (IBM Plex Sans)", "selected": true}],
        "coursebanners": [{"value": "", "label": "As the site (Shown)", "selected": true}],
        "learnerdashboards": [{"value": "", "label": "As the site (Shown)", "selected": true}],
        "mobilenavs": [{"value": "", "label": "As the site (Shown)", "selected": true}],
        "darkmodes": [{"value": "", "label": "As the site (Never)", "selected": true}],
        "activityicons": [{"value": "", "label": "As the site (Colour of the brand)", "selected": true}],
        "certificateframe": {"preview": "data:image/png;base64,"},
        "footer": [{"name": "footerlegalurl", "label": "Legal notice", "value": "", "multiline": false, "placeholder": ""}],
        "logocolours": {"id": "epure-company-logocolours", "inputid": "id_epure_brandcolor", "logourl": null},
        "languages": [{"lang": "fr", "name": "Français", "concepts": [{
            "name": "epure_vocab_fr_company", "label": "Les entreprises s'appellent",
            "options": [{"value": "", "label": "Comme la plateforme (entreprises)", "selected": true},
                {"value": "custom", "label": "Autre mot…", "selected": false}],
            "custom": false, "singular": "", "plural": "", "hasgender": true, "masculine": true, "feminine": false
        }]}]
    }
}}
<div class="epure-company-vocabulary" data-region="epure-company-vocabulary" hidden>
    <input type="hidden" name="{{marker}}" value="1">
    <p class="epure-company-vocabulary-desc">{{#str}}companyappearance_desc, theme_epure{{/str}}</p>
    <section class="epure-company-section" data-epure-company-section="theme" aria-labelledby="epure-company-section-theme">
        <h3 class="epure-company-section-title" id="epure-company-section-theme">{{#str}}companysectiontheme, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companysectiontheme_desc, theme_epure{{/str}}</p>
    </section>
    <section class="epure-company-section" data-epure-company-section="brand" aria-labelledby="epure-company-section-brand">
        <h3 class="epure-company-section-title" id="epure-company-section-brand">{{#str}}settingsbrand, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companysectionbrand_desc, theme_epure{{/str}}</p>
        <div class="epure-company-group" data-epure-company-group="logos">
            <h4 class="epure-company-group-title">{{#str}}settingslogos, theme_epure{{/str}}</h4>
            <p class="epure-company-group-desc">{{#str}}companysectionlogos_desc, theme_epure{{/str}}</p>
            <div class="form-group mb-3 row fitem" data-epure-company-row>
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <span class="mb-0" id="id_epure_logoonbrand_label">{{#str}}logoonbrand, theme_epure{{/str}}</span>
                </div>
                <div class="col-md-9 felement" role="group" aria-labelledby="id_epure_logoonbrand_label">
                    {{#logoonbrand}}
                        {{{html}}}
                        <input type="hidden" name="epure_logoonbrand" id="id_epure_logoonbrand" value="{{draftid}}">
                    {{/logoonbrand}}
                    <p class="small text-muted mt-1 mb-0">{{#str}}companylogoonbrand_help, theme_epure{{/str}}</p>
                </div>
            </div>
        </div>
        <div class="epure-company-group" data-epure-company-group="colours">
            <h4 class="epure-company-group-title">{{#str}}settingscolours, theme_epure{{/str}}</h4>
            <p class="epure-company-group-desc">{{#str}}companysectioncolours_desc, theme_epure{{/str}}</p>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_brandcolor">{{#str}}brandcolor, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 felement">
                    <div class="epure-company-colour">
                        <input type="color" class="epure-company-colour-picker" value="{{#brandcolor}}{{brandcolor}}{{/brandcolor}}{{^brandcolor}}{{sitebrandcolor}}{{/brandcolor}}"
                            aria-label="{{#str}}brandcolor, theme_epure{{/str}}" data-action="pick-colour">
                        <input type="text" class="form-control epure-company-colour-code" id="id_epure_brandcolor" name="epure_brandcolor"
                            value="{{brandcolor}}" placeholder="{{sitebrandcolor}}" size="10" maxlength="7"
                            pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" aria-describedby="id_epure_brandcolor_help" autocomplete="off">
                    </div>
                    <p class="small text-muted mt-1 mb-0" id="id_epure_brandcolor_help">{{#str}}companybrandcolor_help, theme_epure, {{sitebrandcolor}}{{/str}}</p>
                    {{#logocolours}}{{> theme_epure/logo_colours }}{{/logocolours}}
                </div>
            </div>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_accentcolor">{{#str}}accentcolor, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 felement">
                    <div class="epure-company-colour">
                        <input type="color" class="epure-company-colour-picker" value="{{#accentcolor}}{{accentcolor}}{{/accentcolor}}{{^accentcolor}}{{siteaccentcolor}}{{/accentcolor}}"
                            aria-label="{{#str}}accentcolor, theme_epure{{/str}}" data-action="pick-colour">
                        <input type="text" class="form-control epure-company-colour-code" id="id_epure_accentcolor" name="epure_accentcolor"
                            value="{{accentcolor}}" placeholder="{{siteaccentcolor}}" size="10" maxlength="7"
                            pattern="#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" aria-describedby="id_epure_accentcolor_help" autocomplete="off">
                    </div>
                    <p class="small text-muted mt-1 mb-0" id="id_epure_accentcolor_help">{{#str}}companyaccentcolor_help, theme_epure{{/str}}</p>
                </div>
            </div>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_headerstyle">{{#str}}headerstyle, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                    <select class="custom-select form-select" id="id_epure_headerstyle" name="epure_headerstyle">
                        {{#headerstyles}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/headerstyles}}
                    </select>
                </div>
            </div>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_activityicons">{{#str}}activityicons, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                    <select class="custom-select form-select" id="id_epure_activityicons" name="epure_activityicons"
                        aria-describedby="id_epure_activityicons_help">
                        {{#activityicons}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/activityicons}}
                    </select>
                    <p class="small text-muted mt-1 mb-0 w-100" id="id_epure_activityicons_help">{{#str}}companyactivityicons_help, theme_epure{{/str}}</p>
                </div>
            </div>
            <div data-epure-company-slot="iomadcolours"></div>
        </div>
        <div class="epure-company-group" data-epure-company-group="emails">
            <h4 class="epure-company-group-title">{{#str}}settingsemails, theme_epure{{/str}}</h4>
            {{#emails}}{{> theme_epure/company_select }}{{/emails}}
        </div>
        {{#certificateframe}}
        <div class="epure-company-group" data-epure-company-group="certificates">
            <h4 class="epure-company-group-title">{{#str}}companycertificates, theme_epure{{/str}}</h4>
            <div class="form-group mb-3 row fitem" data-epure-company-row>
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <span class="mb-0" id="id_epure_certificateframe_label">{{#str}}certificateframe, theme_epure{{/str}}</span>
                </div>
                <div class="col-md-9 felement">
                    <img class="epure-company-certificateframe" src="{{preview}}" alt="" width="176" height="124">
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="id_epure_certificateframe" name="epure_certificateframe"
                            value="1" aria-describedby="id_epure_certificateframe_help">
                        <label class="form-check-label" for="id_epure_certificateframe">{{#str}}certificateframe_apply, theme_epure{{/str}}</label>
                    </div>
                    <p class="small text-muted mt-1 mb-0" id="id_epure_certificateframe_help">{{#str}}certificateframe_help, theme_epure{{/str}}</p>
                </div>
            </div>
        </div>
        {{/certificateframe}}
    </section>
    <section class="epure-company-section" data-epure-company-section="display" aria-labelledby="epure-company-section-display">
        <h3 class="epure-company-section-title" id="epure-company-section-display">{{#str}}settingsdisplay, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companysectiondisplay_desc, theme_epure{{/str}}</p>
        <div class="form-group mb-3 row fitem">
            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                <label class="mb-0" for="id_epure_font">{{#str}}font, theme_epure{{/str}}</label>
            </div>
            <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                <select class="custom-select form-select" id="id_epure_font" name="epure_font">
                    {{#fonts}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/fonts}}
                </select>
            </div>
        </div>
        <div class="form-group mb-3 row fitem">
            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                <label class="mb-0" for="id_epure_darkmode">{{#str}}darkmode, theme_epure{{/str}}</label>
            </div>
            <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                <select class="custom-select form-select" id="id_epure_darkmode" name="epure_darkmode"
                    aria-describedby="id_epure_darkmode_help">
                    {{#darkmodes}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/darkmodes}}
                </select>
                <p class="small text-muted mt-1 mb-0 w-100" id="id_epure_darkmode_help">{{#str}}companydarkmode_help, theme_epure{{/str}}</p>
            </div>
        </div>
        {{#shapes}}{{> theme_epure/company_select }}{{/shapes}}
    </section>
    <section class="epure-company-section" data-epure-company-section="features" aria-labelledby="epure-company-section-features">
        <h3 class="epure-company-section-title" id="epure-company-section-features">{{#str}}settingsfeatures, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companysectionfeatures_desc, theme_epure{{/str}}</p>
        <div class="epure-company-group" data-epure-company-group="navigation">
            <h4 class="epure-company-group-title">{{#str}}settingsnavigation, theme_epure{{/str}}</h4>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_mobilenav">{{#str}}mobilenav, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                    <select class="custom-select form-select" id="id_epure_mobilenav" name="epure_mobilenav"
                        aria-describedby="id_epure_mobilenav_help">
                        {{#mobilenavs}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/mobilenavs}}
                    </select>
                    <p class="small text-muted mt-1 mb-0 w-100" id="id_epure_mobilenav_help">{{#str}}companymobilenav_help, theme_epure{{/str}}</p>
                </div>
            </div>
            {{#navigation}}{{> theme_epure/company_select }}{{/navigation}}
        </div>
        <div class="epure-company-group" data-epure-company-group="pages">
            <h4 class="epure-company-group-title">{{#str}}settingspages, theme_epure{{/str}}</h4>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_coursebanner">{{#str}}coursebanner, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                    <select class="custom-select form-select" id="id_epure_coursebanner" name="epure_coursebanner"
                        aria-describedby="id_epure_coursebanner_help">
                        {{#coursebanners}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/coursebanners}}
                    </select>
                    <p class="small text-muted mt-1 mb-0 w-100" id="id_epure_coursebanner_help">{{#str}}companycoursebanner_help, theme_epure{{/str}}</p>
                </div>
            </div>
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_learnerdashboard">{{#str}}learnerdashboard, theme_epure{{/str}}</label>
                </div>
                <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                    <select class="custom-select form-select" id="id_epure_learnerdashboard" name="epure_learnerdashboard"
                        aria-describedby="id_epure_learnerdashboard_help">
                        {{#learnerdashboards}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/learnerdashboards}}
                    </select>
                    <p class="small text-muted mt-1 mb-0 w-100" id="id_epure_learnerdashboard_help">{{#str}}companylearnerdashboard_help, theme_epure{{/str}}</p>
                </div>
            </div>
            {{#pages}}{{> theme_epure/company_select }}{{/pages}}
        </div>
    </section>
    <section class="epure-company-section" data-epure-company-section="login" aria-labelledby="epure-company-section-login">
        <h3 class="epure-company-section-title" id="epure-company-section-login">{{#str}}loginsettings, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companylogin_desc, theme_epure{{/str}}</p>
        {{#login}}{{> theme_epure/company_select }}{{/login}}
        {{#logintexts}}
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_{{name}}">{{label}}</label>
                </div>
                <div class="col-md-9 felement">
                    {{#multiline}}
                        <textarea class="form-control" id="id_epure_{{name}}" name="epure_{{name}}" rows="3"
                            placeholder="{{placeholder}}">{{value}}</textarea>
                    {{/multiline}}
                    {{^multiline}}
                        <input type="text" class="form-control" id="id_epure_{{name}}" name="epure_{{name}}" value="{{value}}"
                            placeholder="{{placeholder}}">
                    {{/multiline}}
                </div>
            </div>
        {{/logintexts}}
    </section>
    <section class="epure-company-section" data-epure-company-section="footer" aria-labelledby="epure-company-section-footer">
        <h3 class="epure-company-section-title" id="epure-company-section-footer">{{#str}}footersettings, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companyfooter_desc, theme_epure{{/str}}</p>
        {{#footer}}
            <div class="form-group mb-3 row fitem">
                <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                    <label class="mb-0" for="id_epure_{{name}}">{{label}}</label>
                </div>
                <div class="col-md-9 felement">
                    {{#multiline}}
                        <textarea class="form-control" id="id_epure_{{name}}" name="epure_{{name}}" rows="3"
                            placeholder="{{placeholder}}">{{value}}</textarea>
                    {{/multiline}}
                    {{^multiline}}
                        <input type="url" class="form-control" id="id_epure_{{name}}" name="epure_{{name}}" value="{{value}}"
                            placeholder="{{placeholder}}">
                    {{/multiline}}
                </div>
            </div>
        {{/footer}}
    </section>
    <section class="epure-company-section" data-epure-company-section="vocabulary" aria-labelledby="epure-company-section-vocabulary">
        <h3 class="epure-company-section-title" id="epure-company-section-vocabulary">{{#str}}companyformvocabulary, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companyformvocabulary_desc, theme_epure{{/str}}</p>
        {{#languages}}
            <h4 class="epure-company-vocabulary-lang">{{name}}</h4>
            {{#concepts}}
                <div class="form-group mb-3 row fitem">
                    <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                        <label class="mb-0" for="id_{{name}}">{{label}}</label>
                    </div>
                    <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                        <select class="custom-select form-select" id="id_{{name}}" name="{{name}}" data-epure-vocab-choice>
                            {{#options}}
                                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/options}}
                        </select>
                    </div>
                </div>
                <div data-epure-vocab-custom="id_{{name}}" {{^custom}}hidden{{/custom}}>
                    <div class="form-group mb-3 row fitem">
                        <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                            <label class="mb-0" for="id_{{name}}_singular">{{#str}}vocabsingular, theme_epure{{/str}}</label>
                        </div>
                        <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                            <input type="text" class="form-control" id="id_{{name}}_singular" name="{{name}}_singular" value="{{singular}}" size="24">
                        </div>
                    </div>
                    <div class="form-group mb-3 row fitem">
                        <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                            <label class="mb-0" for="id_{{name}}_plural">{{#str}}vocabplural, theme_epure{{/str}}</label>
                        </div>
                        <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                            <input type="text" class="form-control" id="id_{{name}}_plural" name="{{name}}_plural" value="{{plural}}" size="24">
                        </div>
                    </div>
                    {{#hasgender}}
                        <div class="form-group mb-3 row fitem">
                            <div class="col-md-3 col-form-label d-flex pb-0 pr-md-0 pe-md-0">
                                <label class="mb-0" for="id_{{name}}_gender">{{#str}}vocabgender, theme_epure{{/str}}</label>
                            </div>
                            <div class="col-md-9 d-flex flex-wrap align-items-start felement">
                                <select class="custom-select form-select" id="id_{{name}}_gender" name="{{name}}_gender">
                                    <option value="m" {{#masculine}}selected{{/masculine}}>{{#str}}vocabmasculine, theme_epure{{/str}}</option>
                                    <option value="f" {{#feminine}}selected{{/feminine}}>{{#str}}vocabfeminine, theme_epure{{/str}}</option>
                                </select>
                            </div>
                        </div>
                    {{/hasgender}}
                </div>
            {{/concepts}}
        {{/languages}}
    </section>
    <section class="epure-company-section" data-epure-company-section="advanced" aria-labelledby="epure-company-section-advanced">
        <h3 class="epure-company-section-title" id="epure-company-section-advanced">{{#str}}companysectionadvanced, theme_epure{{/str}}</h3>
        <p class="epure-company-section-desc">{{#str}}companysectionadvanced_desc, theme_epure{{/str}}</p>
    </section>
</div>
