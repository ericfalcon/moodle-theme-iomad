{{!
    @template theme_epure/activity_state

    State of an activity for the learner (late, due soon, in progress, passed…), the same on the course page, in
    the course index and on the dashboard: see \theme_epure\activity_state.

    Example context (json):
    {
        "state": "late", "icon": "fa fa-triangle-exclamation", "text": "Overdue · 13/10/26"
    }
}}
<span class="epure-state epure-state-{{state}}"><i class="icon {{icon}} fa-fw" aria-hidden="true"></i>{{text}}</span>
