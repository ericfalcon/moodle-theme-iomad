{{!
    @template theme_epure/mycourses

    The « My courses » page of Épure: the courses the user teaches and the courses the user
    takes, in two sections, with a search and filters by status.

    Context variables required for this template:
    * hascourses, showheadings
    * filters - value, label, selected
    * sections - role, title, count, courses (see theme_epure/mycourses_card)

    Example context (json):
    {
        "hascourses": true, "showheadings": true,
        "filters": [{"value": "all", "label": "All", "selected": true}],
        "sections": [{"role": "learning", "title": "Courses I take", "count": 1, "courses": [{
            "id": 2, "name": "Safety", "url": "#", "image": "", "category": "Training", "status": "inprogress",
            "teaching": false, "rolename": "Student", "hasprogress": true, "progress": 40, "action": "Continue", "actionurl": "#"
        }]}]
    }
}}
<div class="epure-mycourses" data-region="epure-mycourses">
    {{#hascourses}}
        <div class="epure-mycourses-toolbar">
            <div class="epure-mycourses-search">
                <label class="sr-only visually-hidden" for="epure-mycourses-search">{{#str}}mycourses_search, theme_epure{{/str}}</label>
                <span class="epure-mycourses-search-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
                <input type="search" class="form-control" id="epure-mycourses-search" data-action="search"
                    placeholder="{{#str}}mycourses_search, theme_epure{{/str}}" autocomplete="off">
            </div>
            {{#downloadcerts}}
                <a class="btn btn-secondary epure-mycourses-certificates" href="{{downloadcerts}}">
                    <i class="fa fa-download" aria-hidden="true"></i> {{#str}}downloadcertificates, block_iomad_company_admin{{/str}}
                </a>
            {{/downloadcerts}}
            <div class="epure-mycourses-filters" role="group" aria-label="{{#str}}mycourses_filter, theme_epure{{/str}}">
                {{#filters}}
                    <button type="button" class="epure-mycourses-filter" data-filter="{{value}}"
                        aria-pressed="{{#selected}}true{{/selected}}{{^selected}}false{{/selected}}">{{label}}</button>
                {{/filters}}
            </div>
        </div>
        <p class="sr-only visually-hidden" aria-live="polite" data-region="status"></p>

        {{#sections}}
            <section class="epure-mycourses-section" data-role="{{role}}" {{#showheadings}}aria-labelledby="epure-mycourses-{{role}}"{{/showheadings}}>
                {{#showheadings}}
                    <h2 class="epure-mycourses-section-title" id="epure-mycourses-{{role}}">
                        {{title}} <span class="epure-mycourses-count" data-region="count">{{count}}</span>
                    </h2>
                {{/showheadings}}
                <ul class="epure-mycourses-grid">
                    {{#courses}}
                        {{> theme_epure/mycourses_card }}
                    {{/courses}}
                </ul>
                <p class="epure-mycourses-empty" data-region="empty" hidden>{{#str}}mycourses_nomatch, theme_epure{{/str}}</p>
            </section>
        {{/sections}}
    {{/hascourses}}
    {{^hascourses}}
        <p class="epure-mycourses-none">{{#str}}nocourses{{/str}}</p>
    {{/hascourses}}
</div>
