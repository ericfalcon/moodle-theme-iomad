{{!
    @template theme_epure/error_card

    Error page in the colours of the theme: what happened in plain words, then Moodle's message.

    Example context (json):
    {
        "kind": "denied",
        "icon": "fa-lock",
        "title": "Access denied",
        "lead": "You are not allowed to see this page.",
        "message": "<p class=\"errormessage\">Sorry, but you do not currently have permissions to do that.</p>",
        "hasactions": true,
        "actions": [{"url": "#", "label": "Dashboard"}]
    }
}}
<div class="epure-error-card" data-kind="{{kind}}">
    <span class="epure-error-icon" aria-hidden="true"><i class="fa {{icon}}"></i></span>
    <h2 class="epure-error-title">{{title}}</h2>
    <p class="epure-error-lead">{{lead}}</p>
    <div class="epure-error-details">{{{message}}}</div>
    {{#hasactions}}
    <p class="epure-error-actions">
        {{#actions}}<a class="btn btn-outline-secondary" href="{{url}}">{{label}}</a>{{/actions}}
    </p>
    {{/hasactions}}
</div>
