{{!
    @template theme_epure/catalogue

    Catalogue of the courses: the description of the category, its subcategories, then its courses
    and the courses of its subcategories as cards.

    Example context (json):
    {
        "description": "", "parent": {"name": "Catalogue", "url": "#"},
        "categories": [{"name": "Safety", "url": "#", "count": 3, "hidden": false}], "hascategories": true,
        "count": "3 courses", "hascourses": true, "paging": "",
        "courses": [{"id": 2, "name": "Safety at work", "url": "#", "image": "", "category": "Safety",
            "summary": "", "contacts": "", "hidden": false, "access": "", "accessclass": "", "enrolled": false}]
    }
}}
<div class="epure-catalogue">
    {{#description}}<div class="epure-catalogue-description">{{{description}}}</div>{{/description}}

    {{#hascategories}}
        <nav class="epure-catalogue-categories" aria-label="{{#str}}catalogue_categories, theme_epure{{/str}}">
            <ul>
                {{#parent}}
                    <li><a class="epure-catalogue-chip epure-catalogue-chip-parent" href="{{url}}">
                        <i class="fa fa-arrow-left" aria-hidden="true"></i>{{name}}</a></li>
                {{/parent}}
                {{#categories}}
                    <li><a class="epure-catalogue-chip{{#hidden}} dimmed_text{{/hidden}}" href="{{url}}">{{name}}
                        <span class="epure-catalogue-chip-count">{{count}}</span></a></li>
                {{/categories}}
            </ul>
        </nav>
    {{/hascategories}}
    {{^hascategories}}
        {{#parent}}
            <p class="epure-catalogue-back"><a href="{{url}}"><i class="fa fa-arrow-left" aria-hidden="true"></i>{{name}}</a></p>
        {{/parent}}
    {{/hascategories}}

    {{#hascourses}}
        <p class="epure-catalogue-count">{{count}}</p>
        <div class="epure-catalogue-grid">
            {{#courses}}{{> theme_epure/catalogue_card}}{{/courses}}
        </div>
        {{{paging}}}
    {{/hascourses}}
    {{^hascourses}}
        <p class="epure-catalogue-empty">{{#str}}catalogue_empty, theme_epure{{/str}}</p>
    {{/hascourses}}
</div>
